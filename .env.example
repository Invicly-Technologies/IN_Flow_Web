# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Prisma). Never expose this to any client.
# connection_limit caps Prisma's per-instance pool (default is num_cpus*2+1,
# which exhausts small hosted Postgres plans fast across multiple dev
# restarts) — keep it low for local dev; tune per instance in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&connection_limit=3&pool_timeout=20"

# JWT signing secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# Token lifetimes
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

NODE_ENV="development"

# Absolute origin used to build links in outgoing emails (e.g. workspace-invite
# signup links). No trailing slash.
APP_URL="http://localhost:3000"

# Shared secret for GET /api/v1/cron/reminders — generate with: openssl rand -hex 24
# Wire an external scheduler (cron-job.org, GitHub Actions schedule, Vercel Cron)
# to hit that endpoint every few minutes with ?token=<this value>.
CRON_SECRET="replace-with-a-long-random-secret"

# Initial super-admin account — created/updated by scripts/seed.mjs (idempotent, safe to re-run)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# SMTP — used for the public contact form and workspace-invite notifications.
# For Gmail: use an App Password (not your normal password), port 465 + implicit TLS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@example.com"
SMTP_PASS="replace-with-an-app-password"
CONTACT_NOTIFY_EMAIL="you@example.com"
